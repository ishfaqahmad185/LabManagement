@model LabManagement.Models.Invoice

@{
    ViewData["Title"] = "Edit Invoice";
}

<h2>Edit Invoice</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label for="PatientId">Patient</label>
        <select asp-for="PatientId" asp-items="ViewBag.PatientId" class="form-control" required disabled>
            <!-- Disable editing the patient field for invoices -->
        </select>
    </div>
    <div class="form-group">
        <label for="Amount">Amount</label>
        <input asp-for="Amount" class="form-control" required />
    </div>
    <div class="form-group">
        <label for="Discount">Discount</label>
        <input asp-for="Discount" class="form-control" />
    </div>
    <div class="form-group">
        <label for="PaymentMethod">Payment Method</label>
        <select asp-for="PaymentMethod" class="form-control" required>
            <option value="Cash">Cash</option>
            <option value="EasyPaisa">EasyPaisa</option>
        </select>
    </div>
    <div class="form-group">
        <label for="Status">Status</label>
        <select asp-for="Status" class="form-control" required>
            <option value="Paid">Paid</option>
            <option value="Due">Due</option>
            <option value="Overdue">Overdue</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Update Invoice</button>
</form>
