@{
    ViewBag.Title = "Assign Role to User";
}

<h2>Assign Role</h2>

<form asp-action="AssignRole" method="post">
    <div class="form-group">
        <label for="userId">Select User</label>
        <select id="userId" name="userId" class="form-control">
            @foreach (var user in ViewBag.Users as List<LabManagement.Models.User>)
            {
                <option value="@user.Id">@user.FullName (@user.Email)</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label for="roleId">Select Role</label>
        <select id="roleId" name="roleId" class="form-control">
            @foreach (var role in ViewBag.Roles as List<LabManagement.Models.Role>)
            {
                <option value="@role.Id">@role.Name</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-success">Assign</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
