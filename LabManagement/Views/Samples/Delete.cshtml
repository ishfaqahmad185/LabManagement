@model LabManagement.Models.Sample

@{
    ViewData["Title"] = "Delete Sample";
}

<h1>@ViewData["Title"]</h1>

<h3>Are you sure you want to delete this sample?</h3>

<div>
    <h4>Sample Details</h4>
    <dl class="row">
        <dt class="col-sm-2">Patient</dt>
        <dd class="col-sm-10">@Model.Patient.Name</dd>

        <dt class="col-sm-2">Test</dt>
        <dd class="col-sm-10">@Model.Test.Name</dd>

        <dt class="col-sm-2">Collection Status</dt>
        <dd class="col-sm-10">@Model.CollectionStatus</dd>

        <dt class="col-sm-2">Collected At</dt>
        <dd class="col-sm-10">@Model.CollectedAt.ToString("yyyy-MM-dd HH:mm")</dd>

        <dt class="col-sm-2">Collected By</dt>
        <dd class="col-sm-10">@Model.CollectedBy.FullName</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
</form>
